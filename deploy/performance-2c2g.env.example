# Opt-in starting profile: Go + MySQL + Redis on the SAME 2-core/2-GiB host.
# Merge with existing secrets; do not replace the production .env.
# GOMEMLIMIT/GOMAXPROCS must be in the PROCESS environment before Go starts:
# use deploy/start.sh or systemd EnvironmentFile, not only Go's in-process dotenv loader.
GOMAXPROCS=2
GOMEMLIMIT=384MiB
GOGC=100
DB_MAX_OPEN_CONNS=16
DB_MAX_IDLE_CONNS=8
REDIS_POOL_SIZE=32
REDIS_MIN_IDLE_CONNS=4
ANALYTICS_ENABLED=true
ANALYTICS_BATCH_SIZE=500
ANALYTICS_POLL_INTERVAL_MS=1000
# IP 去标识化哈希密钥：留空保持历史前缀（零行为变化）；设置后不可删除。
# ANALYTICS_IP_HASH_SECRET=
# Keep existing network/query timeouts. Shorter timeouts are not a query optimization.
