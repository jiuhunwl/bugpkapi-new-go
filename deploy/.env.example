# ================= BugPk-Api 环境变量模板 =================
# 复制本文件为 .env，与 start.sh、bugpk-api 同目录。
# 所有密钥类值请使用强随机串（>=32 字节，可用 openssl rand -hex 32 生成）。

# ---------- 运行环境 ----------
# production | staging | development
APP_ENV=production

# 内置前端托管（同一 Go 服务同时提供前端和 API；不使用 Nginx 时保持 true）
FRONTEND_SERVE_ENABLED=true
FRONTEND_DIST_PATH=frontend/dist

# ---------- 数据库迁移开关 ----------
# true=启动自动执行 migrations（默认，适合 migrations 目录在包内时）
# false=跳过迁移（已手动导入全量 SQL 时务必设 false，防止重复建表）
MIGRATION_ENABLED=false

# ---------- 数据库 (MySQL 8.0+) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bugpk_api
DB_USER=bugpk
DB_PASSWORD=请改成强密码

# ---------- 看板分析汇总 ----------
# 保持开启可让首页、管理员工作台、访问态势和风控查询成本与原始日志总量解耦。
ANALYTICS_ENABLED=true
ANALYTICS_BATCH_SIZE=5000
ANALYTICS_POLL_INTERVAL_MS=1000
# IP 去标识化哈希密钥（汇总/风控/审计表共用）。留空保持历史公开前缀（零行为
# 变化）；设置后即轮换分组键（受影响汇总表需按交付说明重建），且设置后不可
# 再删掉。生产建议 ≥32 字节随机串，例如：openssl rand -hex 32
ANALYTICS_IP_HASH_SECRET=

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- 安全密钥（必填，生产强制） ----------
# JWT 签名密钥，>=32 字节
JWT_SECRET=openssl rand -hex 32 生成后填入

# 所有环境：管理员缺失、仍是初始占位哈希或使用已公开默认口令时必须设置。
# 使用独有的新口令；已有自定义密码不会被覆盖。成功初始化/轮换后可移除此变量。
INITIAL_ADMIN_PASSWORD=

# 支付配置加密密钥（支付宝/微信私钥加密，>=32 字节）
PAYMENT_CONFIG_SECRET=openssl rand -hex 32 生成后填入

# 系统配置加密密钥（SMTP/SMS 等敏感字段，>=32 字节；留空则回退用 PAYMENT_CONFIG_SECRET）
SYSTEM_CONFIG_SECRET=

# ---------- 反向代理（宝塔 Nginx 前置时建议开启） ----------
# 只填可信代理 IP（宝塔本机一般是 127.0.0.1），多个用逗号分隔
SERVER_TRUSTED_PROXIES=127.0.0.1

# ---------- 出口代理测试 ----------
# 仅允许无凭据的公网 HTTP(S) 地址；管理端不能覆盖此目标。
PROXY_TEST_URL=https://api.ipify.org?format=json

# ---------- 第三方登录出站 ----------
# 仅本地联调 fake provider 时允许私网地址；生产必须为 false。
OAUTH_ALLOW_PRIVATE_ENDPOINTS=false
OAUTH_HTTP_TIMEOUT_SECONDS=10

# ---------- SEO ----------
# 站点对外基础地址（用于动态 sitemap.xml 的绝对 URL，不含结尾斜杠；留空则 sitemap 接口回退请求 Host）
# SEO_SITE_URL=https://www.example.com

# ---------- 可选：邮件 ----------
# SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_TLS=true
# 邮件模板语言跟随浏览器 Accept-Language：
#   EMAIL_CODE_SUBJECT / EMAIL_CODE_TEMPLATE / EMAIL_RESET_SUBJECT / EMAIL_RESET_TEMPLATE = 默认模板（中文，zh/其它语言使用）
#   EMAIL_CODE_SUBJECT_EN / EMAIL_CODE_TEMPLATE_EN / EMAIL_RESET_SUBJECT_EN / EMAIL_RESET_TEMPLATE_EN = 英文模板（en 使用，为空回退默认）
# 占位符均支持 {{code}} / {{minutes}} / {{siteName}}。
# EMAIL_CODE_SUBJECT=BugPk-Api 验证码
# EMAIL_CODE_TEMPLATE=您的验证码是 {{code}}，{{minutes}} 分钟内有效。如非本人操作，请忽略本邮件。
# EMAIL_RESET_SUBJECT=BugPk-Api 找回密码验证码
# EMAIL_RESET_TEMPLATE=您正在找回密码，验证码是 {{code}}，{{minutes}} 分钟内有效。如非本人操作，请忽略本邮件。
# EMAIL_CODE_SUBJECT_EN=BugPk-Api verification code
# EMAIL_CODE_TEMPLATE_EN=Your verification code is {{code}} and is valid for {{minutes}} minutes. Ignore this email if you did not request it.
# EMAIL_RESET_SUBJECT_EN=BugPk-Api password reset code
# EMAIL_RESET_TEMPLATE_EN=Your password reset code is {{code}} and is valid for {{minutes}} minutes. Ignore this email if you did not request it.
# 全站发信熔断（注册/绑定/找回密码共用计数器）：防止被刷后 SMTP 账号报废、正常用户收不到信。
# 0 表示使用内置默认值 30/分钟、300/小时。
# EMAIL_SEND_GLOBAL_MINUTE_LIMIT=30
# EMAIL_SEND_GLOBAL_HOUR_LIMIT=300

# ---------- 可选：支付回调 ----------
# 支付宝/微信回调需要公网 HTTPS 地址（在配置页填写完整回调地址）
